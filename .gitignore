# Vault-local runtime and recovery state may contain note text or source URLs.
.vault-meta/

# Local MCP launch configuration may contain commands or credentials. Share a
# reviewed `.mcp.example.json` instead of committing the live file.
.mcp.json

# Cloud-drive staging areas (Google Drive/Nutstore). Never vault content:
# `.tmp.driveupload` alone reached ~200 MB of transient upload parts.
.tmp.driveupload/
.tmp.drivedownload/

# Obsidian and operating-system session state.
.obsidian/workspace*.json
.trash/
.DS_Store
Thumbs.db

# Cloned/study repositories stored outside the visible wiki
.raw/repos/

# QMD generated index and runtime state (config is tracked).
.qmd/*
!.qmd/index.yml

# Attention plugin settings may contain encrypted credentials and personal goals.
.obsidian/plugins/attention-allocator/data.json
