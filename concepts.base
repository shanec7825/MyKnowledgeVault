filters: type == "concept"
formulas:
  days_since_updated: if(updated, (now() - date(updated)).days.round(0), "")
  status_icon: if(status == "evergreen", "🌲", if(status == "developing", "🌱", if(status == "seed", "🌰", "•")))
  related_count: if(related, related.length, 0)
  sources_count: if(sources, sources.length, 0)
properties:
  file.name:
    displayName: File
  title:
    displayName: Title
  domain:
    displayName: Domain
  complexity:
    displayName: Complexity
  status:
    displayName: Status
  formula.days_since_updated:
    displayName: Days Since Update
  formula.related_count:
    displayName: Related
  formula.sources_count:
    displayName: Sources
views:
  - type: table
    name: Table
    order:
      - file.name
      - title
      - formula.status_icon
      - status
      - domain
      - complexity
      - formula.days_since_updated
      - formula.related_count
      - formula.sources_count
    sort: []
  - type: table
    name: By Domain
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - title
      - formula.status_icon
      - status
      - complexity
      - formula.days_since_updated
      - formula.related_count
  - type: table
    name: Developing
    filters: status == "developing"
    order:
      - file.name
      - title
      - domain
      - complexity
      - formula.days_since_updated
      - formula.related_count
      - formula.sources_count
  - type: table
    name: Evergreen
    filters: status == "evergreen"
    order:
      - file.name
      - title
      - domain
      - formula.days_since_updated
      - formula.related_count
