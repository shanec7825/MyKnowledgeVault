# Global filter applies to every view in this base
filters: 'type == "source"'

formulas:
  days_since_updated: 'if(updated, (now() - date(updated)).days.round(0), "")'
  status_icon: 'if(status == "seed", "🌰", if(status == "active", "📄", "•"))'
  related_count: 'if(related, related.length, 0)'
  backlinks_count: 'file.backlinks.length'

properties:
  file.name:
    displayName: "File"
  title:
    displayName: "Title"
  author:
    displayName: "Author"
  status:
    displayName: "Status"
  source_type:
    displayName: "Type"
  formula.status_icon:
    displayName: ""
  formula.days_since_updated:
    displayName: "Days Since Update"
  formula.related_count:
    displayName: "Related"
  formula.backlinks_count:
    displayName: "Referenced By"
  file.folder:
    displayName: "Folder"

views:
  - type: table
    name: "Table"
    order:
      - file.name
      - title
      - author
      - formula.status_icon
      - status
      - source_type
      - formula.days_since_updated
      - formula.related_count
      - formula.backlinks_count
      - file.folder

  - type: table
    name: "Seeds"
    filters: 'status == "seed"'
    order:
      - file.name
      - title
      - author
      - source_type
      - formula.days_since_updated
      - formula.related_count

  - type: table
    name: "Active"
    filters: 'status == "active"'
    order:
      - file.name
      - title
      - author
      - source_type
      - formula.days_since_updated
      - formula.backlinks_count
      - file.folder

  - type: table
    name: "Webpages"
    filters: 'source_type == "webpage"'
    order:
      - file.name
      - title
      - author
      - status
      - formula.days_since_updated
      - formula.related_count
